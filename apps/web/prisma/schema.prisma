generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id(map: "users_pk")
  name           String
  email          String      @unique(map: "ak_users_email")
  email_verified Boolean     @default(false)
  image          String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @default(now()) @db.Timestamptz(6)
  account        Account[]
  admins         admins[]
  companies      companies[]
  customers      customers?
  session        Session[]

  @@map("user")
}

model Session {
  id         String   @id(map: "sessions_pk")
  expires_at DateTime @db.Timestamptz(6)
  token      String   @unique(map: "ak_sessions_token")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  ip_address String?
  user_agent String?
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sessions_users")

  @@index([user_id], map: "idx_sessions_user_id")
  @@map("session")
}

model Account {
  id                       String    @id(map: "accounts_pk")
  account_id               String
  provider_id              String    @unique(map: "ak_accounts_provider")
  user_id                  String
  access_token             String?
  refresh_token            String?
  id_token                 String?
  access_token_expires_at  DateTime? @db.Timestamptz(6)
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  scope                    String?
  password                 String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @db.Timestamptz(6)
  user                     User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "accounts_users")

  @@index([user_id], map: "idx_account_user_id")
  @@map("account")
}

model Verification {
  id         String   @id(map: "verifications_pk")
  identifier String
  value      String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verification")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admins {
  id        String      @id(map: "admins_pk")
  user_id   String
  name      String
  role      String
  user      User        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "admins_user")
  companies companies[]

  @@index([user_id], map: "idx_admins_user_id")
}

model categories {
  id                  Int                   @id(map: "categories_pk") @default(autoincrement())
  name                String                @unique(map: "idx_categories_name")
  description         String?
  categories_products categories_products[]
}

model categories_products {
  categories_id Int
  products_id   String
  categories    categories @relation(fields: [categories_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "table_14_categories")
  products      products   @relation(fields: [products_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "table_14_products")

  @@id([categories_id, products_id], map: "categories_products_pk")
  @@index([products_id], map: "idx_categories_products_products_id")
}

model companies {
  id                           String         @id(map: "companies_pk") @default(dbgenerated("gen_random_uuid()"))
  owner_id                     String
  company_name                 String
  certificate_of_incorporation String?
  is_verified                  Boolean        @default(false)
  approved_by                  String?
  email                        String         @unique(map: "company_email")
  phone_number                 String?
  created_at                   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime       @default(now()) @db.Timestamptz(6)
  deleted_at                   DateTime?      @db.Timestamptz(6)
  founded_at                   DateTime?      @db.Date
  website                      String?
  address                      String?
  linkedin_url                 String?
  head_of_company              String?
  employee_count               Int?
  admins                       admins?        @relation(fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_admins")
  user                         User           @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "companies_user")
  products                     products[]
  transactions                 transactions[]

  @@index([approved_by], map: "idx_companies_approved_by")
  @@index([owner_id], map: "idx_companies_owner_id")
}

model customers {
  id                     String                   @id(map: "customers_pk")
  name                   String
  address                String
  profile_picture        String?
  phone                  String
  email                  String                   @unique(map: "customer_email")
  gender                 String
  city                   String
  region                 String
  postal_code            String
  country                String
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  user                   User                     @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_user")
  orders                 orders[]
  reviews                reviews[]
  shopping_cart_products shopping_cart_products[]
  transactions           transactions[]

  @@index([country, city], map: "idx_customers_country_city")
  @@index([id], map: "idx_customers_id_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id              String            @id(map: "orders_pk") @default(dbgenerated("gen_random_uuid()"))
  customers_id    String
  order_date      DateTime          @db.Date
  shipped_date    DateTime?         @db.Date
  shipper         String
  tracking_number String
  status          String
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  customers       customers         @relation(fields: [customers_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_customers")
  orders_products orders_products[]
  transactions    transactions[]

  @@index([customers_id, order_date(sort: Desc)], map: "idx_orders_customers_date")
  @@index([customers_id], map: "idx_orders_customers_id")
  @@index([order_date], map: "idx_orders_order_date")
  @@index([status], map: "idx_orders_status")
  @@index([customers_id, status], map: "idx_orders_status_customers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders_products {
  products_id String
  orders_id   String
  unit_price  Decimal  @db.Decimal(12, 2)
  quantity    Int
  discount    Decimal  @db.Decimal(3, 2)
  orders      orders   @relation(fields: [orders_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_products_orders")
  products    products @relation(fields: [products_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "orders_products_products")

  @@id([products_id, orders_id], map: "orders_products_pk")
  @@index([orders_id], map: "idx_orders_products_orders_id")
  @@index([products_id], map: "idx_orders_products_products_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                     String                   @id(map: "products_pk") @default(dbgenerated("gen_random_uuid()"))
  name                   String
  unit_price             Decimal                  @db.Decimal(12, 2)
  specifications         Json
  companies_id           String
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  stock                  Int
  isactive               Boolean
  categories_products    categories_products[]
  orders_products        orders_products[]
  companies              companies                @relation(fields: [companies_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "products_companies")
  reviews                reviews[]
  shopping_cart_products shopping_cart_products[]

  @@index([companies_id], map: "idx_products_companies_id")
  @@index([companies_id, isactive], map: "idx_products_company_active")
  @@index([name], map: "idx_products_name")
  @@index([unit_price], map: "idx_products_unit_price")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id               String    @id(map: "reviews_pk") @default(dbgenerated("gen_random_uuid()"))
  products_id      String
  customers_id     String
  stars            Int       @db.SmallInt
  comment          String?
  report_points    Int
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  reviewer_comment String?
  customers        customers @relation(fields: [customers_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_customers")
  products         products  @relation(fields: [products_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "reviews_products")

  @@unique([customers_id, products_id], map: "ux_reviews_customer_product")
  @@index([customers_id], map: "idx_reviews_customers_id")
  @@index([products_id, created_at(sort: Desc)], map: "idx_reviews_products_created_at")
  @@index([products_id], map: "idx_reviews_products_id")
  @@index([products_id, stars], map: "idx_reviews_products_stars")
}

model shopping_cart_products {
  customers_id String
  products_id  String
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)
  customers    customers @relation(fields: [customers_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shopping_carts_products_customers")
  products     products  @relation(fields: [products_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "shopping_carts_products_products")

  @@id([customers_id, products_id], map: "shopping_cart_products_pk")
  @@index([products_id], map: "idx_shopping_cart_products_products_id")
  @@index([customers_id, updated_at(sort: Desc)], map: "idx_shopping_cart_products_updated_at")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id           String    @id(map: "transactions_pk") @default(dbgenerated("gen_random_uuid()"))
  customers_id String
  companies_id String
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @db.VarChar(3)
  isrefund     Boolean
  orders_id    String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  companies    companies @relation(fields: [companies_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "table_16_companies")
  customers    customers @relation(fields: [customers_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "table_16_customers")
  orders       orders    @relation(fields: [orders_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "transactions_orders")

  @@index([companies_id], map: "idx_transactions_companies_id")
  @@index([companies_id, created_at(sort: Desc)], map: "idx_transactions_company_date")
  @@index([created_at], map: "idx_transactions_created_at")
  @@index([customers_id, created_at(sort: Desc)], map: "idx_transactions_customer_date")
  @@index([customers_id], map: "idx_transactions_customers_id")
  @@index([orders_id], map: "idx_transactions_orders_id")
}
